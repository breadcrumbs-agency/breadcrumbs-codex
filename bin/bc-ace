#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -d "$root/lib" ]; then  # a bundle: the layers of breadcrumbs-common under lib/
  export PYTHONPATH="$root/lib:$root${PYTHONPATH:+:$PYTHONPATH}"
else
  parts=$(CDPATH= cd -- "$root/.." && pwd)
  source_path="$root"
  [ -d "$parts/breadcrumbs-spacegraph" ] && source_path="$parts/breadcrumbs-spacegraph:$source_path"
  [ -d "$parts/breadcrumbs-common" ] && source_path="$parts/breadcrumbs-common:$source_path"
  export PYTHONPATH="$source_path${PYTHONPATH:+:$PYTHONPATH}"
fi
case "${1:-}" in
  enable|disable|status) exec sh "$root/bin/bc-python" -m breadcrumbs_codex.managed "$@" ;;
esac
exec sh "$root/bin/bc-python" -m breadcrumbs_codex.provider "$@"
