#!/bin/sh
# Start breadcrumbs for Codex's project-scoped MCP server. A bundled release places the common layer under lib/;
# a source checkout discovers the sibling breadcrumbs-common and breadcrumbs-spacegraph folders when present.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
codex_home="${CODEX_HOME:-$HOME/.codex}"
export BREADCRUMBS_HOME="${BREADCRUMBS_HOME:-$codex_home/breadcrumbs}"
export BREADCRUMBS_HERE="${BREADCRUMBS_HERE:-1}"
if [ -d "$here/lib" ]; then
  export PYTHONPATH="$here/lib:$here${PYTHONPATH:+:$PYTHONPATH}"
else
  parts=$(CDPATH= cd -- "$here/.." && pwd)
  source_path="$here"
  [ -d "$parts/breadcrumbs-spacegraph" ] && source_path="$parts/breadcrumbs-spacegraph:$source_path"
  [ -d "$parts/breadcrumbs-common" ] && source_path="$parts/breadcrumbs-common:$source_path"
  export PYTHONPATH="$source_path${PYTHONPATH:+:$PYTHONPATH}"
fi

sh "$here/bin/bc-python" -m breadcrumbs_codex.managed ensure || :
exec sh "$here/bin/bc-python" -m breadcrumbs core mcp
